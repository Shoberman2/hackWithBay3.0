# Neo4j Aura (Free tier)
# Also accepts common Aura aliases:
#   AURA_CONNECTION_URI / AURA_USERNAME / AURA_PASSWORD
#   NEO4J_URL / NEO4J_USER / NEO4J_PASS
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# Butterbase (auth, DB, AI gateway, payments)
BUTTERBASE_APP_ID=
BUTTERBASE_ANON_KEY=
BUTTERBASE_SERVICE_KEY=
BUTTERBASE_AI_KEY=
BUTTERBASE_API_URL=https://api.butterbase.ai

# RocketRide Cloud (pipeline hosting)
ROCKETRIDE_APIKEY=
ROCKETRIDE_URI=https://api.rocketride.ai

# Data sources
GITHUB_TOKEN=
PRODUCTHUNT_TOKEN=

# App behavior
# DEMO_MODE=true runs explicit local fixtures/canned responses.
# For live judging runs set DEMO_MODE=false and NEXT_PUBLIC_DEMO_MODE=false.
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true
FREE_REPORT_UNLOCK=false
DEBUG=false
