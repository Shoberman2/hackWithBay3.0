{
  "components": [
    {
      "id": "webhook_1",
      "provider": "webhook",
      "name": "Extraction input",
      "description": "Source node. Receives application/json payloads of shape { idea, tags, raw_documents } over the RocketRide SDK send() call.",
      "config": {
        "hideForm": true,
        "mode": "Source",
        "parameters": {},
        "type": "webhook"
      },
      "ui": { "position": { "x": 80, "y": 200 }, "measured": { "width": 150, "height": 66 } }
    },
    {
      "id": "parse_1",
      "provider": "parse",
      "name": "Parse webhook JSON",
      "description": "Converts the webhook payload into text for the structured extraction node.",
      "config": { "parameters": {} },
      "input": [{ "lane": "tags", "from": "webhook_1" }],
      "ui": { "position": { "x": 270, "y": 200 }, "measured": { "width": 150, "height": 66 } }
    },
    {
      "id": "extract_data_1",
      "provider": "extract_data",
      "name": "Extract graph entities",
      "description": "Structured extraction stage. It uses the controlled Butterbase-backed LLM node and returns an ExtractedBatch JSON object.",
      "config": {
        "instructions": [
          "You are the entity-extraction stage of a competitive-landscape pipeline.",
          "Input text is JSON with { idea, tags, raw_documents: [{ url, source_type, title, text, date? }] }.",
          "Output ONLY a single JSON object. No markdown, prose, or code fences.",
          "All arrays are required: companies, founders, investors, features, launches, segments, funding_rounds, snapshots, posts, moat_claims, traction_signals, relationships.",
          "Every entity must include source_url copied verbatim from the input document URL. Never invent URLs.",
          "Every relationship must include props.confidence from 0 to 1.",
          "Relationship endpoints use natural keys from this batch. RELEVANT_TO points to the literal idea text.",
          "Unknown fields are null. Omit weak or unsupported facts."
        ],
        "parameters": {
          "response_format": "json_object",
          "schema_name": "ExtractedBatch"
        }
      },
      "input": [{ "lane": "text", "from": "parse_1" }],
      "ui": { "position": { "x": 460, "y": 200 }, "measured": { "width": 150, "height": 66 } }
    },
    {
      "id": "llm_openai_1",
      "provider": "llm_openai",
      "name": "Butterbase AI gateway",
      "description": "LLM control provider pointed at the Butterbase OpenAI-compatible gateway. The key is injected by scripts/deploy-rocketride.ts in memory, not stored in git.",
      "config": {
        "profile": "openai-5-2",
        "openai-5-2": {
          "apikey": "${ROCKETRIDE_BUTTERBASE_AI_KEY}",
          "base_url": "https://api.butterbase.ai/v1",
          "model": "anthropic/claude-3.5-sonnet",
          "modelTotalTokens": 200000
        },
        "parameters": {
          "temperature": 0
        }
      },
      "control": [{ "classType": "llm", "from": "extract_data_1" }],
      "ui": { "position": { "x": 460, "y": 360 }, "measured": { "width": 150, "height": 66 } }
    },
    {
      "id": "response_answers_1",
      "provider": "response_answers",
      "name": "ExtractedBatch JSON",
      "description": "Returns the extraction result as the synchronous SDK response.",
      "config": { "laneName": "answers" },
      "input": [{ "lane": "answers", "from": "extract_data_1" }],
      "ui": { "position": { "x": 650, "y": 200 }, "measured": { "width": 150, "height": 66 } }
    }
  ],
  "project_id": "2849d160-3b2a-4119-a6d1-b070070c18d3",
  "source": "webhook_1",
  "viewport": { "x": 0, "y": 0, "zoom": 1 },
  "version": 1
}
